<mujoco model="unitree-r1-scene">
  <include file="r1_mocap.xml"/>

  <statistic center="0 0 0.6" extent="1.2"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-15" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.42 0.5" rgb2="0.08 0.1 0.13"
      width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.32 0.34 0.36" rgb2="0.24 0.26 0.28" markrgb="0.5 0.5 0.5"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="4 4"
      reflectance="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"
      contype="1" conaffinity="0" priority="1" friction="0.6" condim="3"/>
    <light diffuse="0.5 0.5 0.5" pos="-3 -3 5" dir="3 3 -5" castshadow="true"/>
    <light diffuse="0.35 0.35 0.35" pos="3 -2 4" dir="-3 2 -4" castshadow="false"/>
  </worldbody>
</mujoco>
